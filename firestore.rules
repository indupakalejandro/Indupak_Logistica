rules_version = '2';

// Reglas de seguridad de Indupak Logística.
// Copiar este contenido en Firebase Console > Firestore Database > Reglas, y Publicar.
// Antes: habilitar Authentication > Método de acceso > Correo electrónico/contraseña
// y DESHABILITAR "Anónimo", para que solo entren usuarios con contraseña.
service cloud.firestore {
  match /databases/{database}/documents {

    function rutaPerfil(uid) {
      return /databases/$(database)/documents/artifacts/default-app-id/usuarios/$(uid);
    }
    function conContrasena() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function perfil() {
      return get(rutaPerfil(request.auth.uid)).data;
    }
    // Usuario con contraseña, con perfil y no desactivado.
    function activo() {
      return conContrasena() && exists(rutaPerfil(request.auth.uid)) && perfil().activo != false;
    }
    function tieneRol(roles) {
      return activo() && perfil().rol in roles;
    }
    function existeAdmin() {
      return exists(/databases/$(database)/documents/artifacts/default-app-id/configuracion/accesos);
    }

    // Lo que el administrador habilitó en Configuración → Usuarios → "Qué ve cada rol"
    // (documento configuracion/permisos: { rrhh: [...secciones], operario: [...secciones] }).
    // Si nunca se tocaron los interruptores, valen los roles por defecto que se pasan.
    function rutaPermisos() {
      return /databases/$(database)/documents/artifacts/default-app-id/configuracion/permisos;
    }
    function puedeUsar(seccion, rolesPorDefecto) {
      return tieneRol(['admin'])
        || (activo() && (exists(rutaPermisos())
              ? (perfil().rol in get(rutaPermisos()).data && seccion in get(rutaPermisos()).data[perfil().rol])
              : perfil().rol in rolesPorDefecto));
    }

    // ---- Usuarios y roles ----
    match /artifacts/default-app-id/usuarios/{uid} {
      allow read: if activo() && (request.auth.uid == uid || tieneRol(['admin']));
      // El primer administrador se crea a sí mismo solo mientras no haya ninguno.
      allow create: if tieneRol(['admin'])
        || (conContrasena() && request.auth.uid == uid && !existeAdmin() && request.resource.data.rol == 'admin');
      // Nadie se cambia su propio rol ni se desactiva. Cada uno solo puede tocar la marca de
      // "cambiar contraseña" de su propio perfil (al entrar con la inicial y al elegir la suya).
      allow update: if (tieneRol(['admin']) && request.auth.uid != uid)
        || (activo() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['debeCambiarClave', 'claveCambiadaEn']));
      // El administrador puede eliminar a otros usuarios (nunca a sí mismo).
      allow delete: if tieneRol(['admin']) && request.auth.uid != uid;
    }

    // ---- Configuración: la lee todo usuario activo y la cambia solo el administrador ----
    match /artifacts/default-app-id/configuracion/{id} {
      allow read: if activo();
      allow write: if tieneRol(['admin']);
      // Marca de "ya hay administrador": se crea junto con el primer administrador, en el mismo paso.
      allow create: if id == 'accesos' && conContrasena() && !existeAdmin()
        && getAfter(rutaPerfil(request.auth.uid)).data.rol == 'admin';
    }

    // ---- Personal: lo editan quienes tienen habilitado "Horario: reportes y personal" (por defecto, RRHH) ----
    match /artifacts/default-app-id/personal/{id} {
      allow read: if activo();
      allow write: if puedeUsar('horarios-gestion', ['rrhh']);
    }

    // ---- Pagos: los cargan quienes tienen habilitada la sección Pagos ----
    match /artifacts/default-app-id/pendingPayments/{id} {
      allow read: if activo();
      allow write: if puedeUsar('pagos', []);
    }
    match /artifacts/default-app-id/paymentHistory/{id} {
      allow read: if activo();
      allow write: if puedeUsar('pagos', []);
    }
    match /artifacts/default-app-id/monthlyKiloSummaries/{id} {
      allow read: if activo();
      allow write: if puedeUsar('pagos', []);
    }

    // ---- Contactos: proveedores, contactos y comisionistas, según la sección Contactos ----
    match /artifacts/default-app-id/proveedores/{id} {
      allow read: if activo();
      allow write: if puedeUsar('contactos', []);
    }
    match /artifacts/default-app-id/contactos/{id} {
      allow read: if activo();
      allow write: if puedeUsar('contactos', []);
    }
    match /artifacts/default-app-id/comisionistas/{id} {
      allow read: if activo();
      allow write: if puedeUsar('contactos', []);
    }

    // ---- Asistencia: todos marcan y pueden deshacer una marca ----
    match /artifacts/default-app-id/asistencia/{id} {
      allow read, create, update: if activo();
      allow delete: if activo();
    }

    // ---- Marcas del lector de huella/tarjeta (las guarda el usuario "lector" desde Cloudflare) ----
    // Todos los usuarios activos las leen y las marcan como procesadas; solo el administrador podría borrarlas.
    match /artifacts/default-app-id/marcasLector/{id} {
      allow read, create, update: if activo();
      allow delete: if false;
    }

    // ---- Todo lo demás: lo usa cualquier usuario activo, salvo las colecciones de arriba
    //      (que tienen su propia regla) y las listas de configuración, que son solo del administrador ----
    match /artifacts/default-app-id/{coleccion}/{id} {
      allow read: if activo() && coleccion != 'usuarios';
      allow write: if activo() && (
        tieneRol(['admin'])
        || !(coleccion in [
          'usuarios', 'configuracion', 'personal', 'asistencia', 'marcasLector',
          'pendingPayments', 'paymentHistory', 'monthlyKiloSummaries',
          'proveedores', 'contactos', 'comisionistas',
          'categories', 'unitsOfMeasure', 'roles', 'localidades', 'plasticSuppliers'
        ])
      );
    }
  }
}
